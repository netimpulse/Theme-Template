# Beispiel-Konfiguration. KEINE echten Secrets in diese Datei eintragen.
# Die echte .env wird per .gitignore ignoriert und nur lokal/in der Session gefuellt.

# Shopify Theme Access Token (Theme Access App im Dev-Store erzeugt)
SHOPIFY_CLI_THEME_TOKEN=shptka_HIER_TOKEN_EINSETZEN

# Storefront-Passwort des Dev-Stores (Shopify Admin -> Online Store -> Preferences)
# Wird vom Playwright global-setup fuer den Login genutzt. Ohne Passwortschutz leer lassen.
SHOPIFY_STOREFRONT_PASSWORD=

# Optional: Test-Theme-ID, ersetzt den Platzhalter __THEME_ID__ in tests/fixtures.ts
# SHOPIFY_TEST_THEME_ID=
